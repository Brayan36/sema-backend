# Copiar este archivo como .env y ajustar los valores. El .env NUNCA se sube a Git.

# development | production
ENVIRONMENT=development

# Zona horaria de nuestra ubicación. Se usa en la lógica que depende de la hora local
# (ej. qué día es hoy en Colombia). Las fechas de la API siempre se entregan en UTC.
TIMEZONE=America/Bogota

# Ruta del archivo SQLite, relativa a la carpeta backend/
DB_PATH=data/sema.db

# Orígenes permitidos del frontend (formato JSON). Vite usa el puerto 5173 por defecto.
CORS_ORIGINS=["http://localhost:5173"]

# JWT: generar un secreto con
#   py -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Primer usuario: se crea al arrancar si no hay usuarios activos
FIRST_USER_EMAIL=admin@sema.example
FIRST_USER_PASSWORD=change-me-please
